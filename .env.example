# DeepSeek API key, used to judge category/mood/irritation/anger from the transcript
DEEPSEEK_API_KEY=

# Notion integration token (create at https://www.notion.so/my-integrations)
# Must be shared/invited to the "Voice Journal" database in your workspace
NOTION_TOKEN=

# The "Voice Journal" database created for this app
NOTION_DATABASE_ID=9f059cf5-b09b-435e-941e-3283055e6b7d
NOTION_DATA_SOURCE_ID=582f8887-d711-4115-9b62-5d613cbdeec5

# Basic auth gate. If APP_PASSWORD is left blank, the app runs with no password
# (fine for localhost, NOT recommended once deployed publicly).
APP_USERNAME=journal
APP_PASSWORD=

PORT=3000
